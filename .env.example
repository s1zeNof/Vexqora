# Public Supabase values used by the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only values. Never expose these with NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_URL=https://your-project.supabase.co
ENCRYPTION_MASTER_KEY=base64-encoded-32-byte-key

# Worker and integrations (added in later stages).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=

