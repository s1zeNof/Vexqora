{
  "name": "vexqora-trade",
  "version": "0.3.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@crypto-bot/web",
    "dev:worker": "npm run dev --workspace=@crypto-bot/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "data:download": "tsx packages/data-lake/src/cli.ts download",
    "data:trades": "tsx packages/data-lake/src/cli.ts trades",
    "data:derivatives": "tsx packages/data-lake/src/cli.ts derivatives",
    "data:status": "tsx packages/data-lake/src/cli.ts status",
    "data:backtest": "tsx packages/data-lake/src/backtest-runner.ts",
    "ml:train": "npm run train --workspace=@crypto-bot/ml-engine",
    "ml:serve": "npm run serve --workspace=@crypto-bot/ml-engine"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "engines": { "node": ">=22" }
}

